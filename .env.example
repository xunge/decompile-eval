# Set only for remote models that require an API key.
# OPENAI_API_KEY=your-key-here
# DEC_EVAL_SANDBOX_IMAGE=gcc:14
# DEC_EVAL_DATA_DIR=./storage

# Dynamic pipeline (v0.4 defaults)
# INFERENCE_CONCURRENCY=0          # 0=AUTO
# COMPILE_CONCURRENCY=64
# MAX_PENDING_COMPILE=128
# AUTO_INITIAL_INFLIGHT=32
# AUTO_MAX_INFLIGHT=256
# AUTO_STEP=16
# COMPILE_MEMORY_FRACTION=0.6
# COMPILE_MEMORY_PER_WORKER_MB=1024
# DEC_EVAL_DIAGNOSTICS=1
# MAX_DIAGNOSTIC_CASES=200
# INFERENCE_TIMEOUT=180
# INFERENCE_RETRIES=2
# COMPILE_TIMEOUT=60
# TEST_TIMEOUT=10

# Context / tokenizer
# MAX_MODEL_LEN=4096
# TOKENIZER_TIMEOUT=10

# Optional offline batch through vllm.LLM (backend environment must have vllm)
# DEC_EVAL_BATCH_MODEL_PATH=/home/jiang/share/model/llm4decompile-1.3b-v1.5
# DEC_EVAL_BATCH_SIZE=32

# vLLM Prometheus metrics in the progress API (1=on, 0=off)
# DEC_EVAL_VLLM_METRICS=1

# Local vLLM deployment management / GPU monitoring
# DEC_EVAL_VLLM_BIN=/home/jiang/venvs/vllm/bin/vllm
# DEC_EVAL_ALLOW_DEPLOY=1
# DEC_EVAL_ADMIN_TOKEN=change-me
# DEC_EVAL_DEPLOY_START_TIMEOUT=240
# DEC_EVAL_DEPLOY_STOP_TIMEOUT=30
# DEC_EVAL_DEPLOY_MAX_RUNNING=4
# DEC_EVAL_GPU_MONITOR=1
# DEC_EVAL_GPU_INTERVAL=1.5
# DEC_EVAL_GPU_HISTORY=1800

# Dataset upload: 0 = unlimited (default); set bytes to impose a cap.
# DEC_EVAL_MAX_DATASET_UPLOAD_BYTES=0
